# --- Google Cloud ---
GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json
GOOGLE_KEY_LOCAL_PATH=./google-credentials.json
GEMINI_API_KEY=dein_gemini_api_key_hier

# --- Audio / TTS ---
ELEVENLABS_API_KEY=dein_elevenlabs_key_hier (falls genutzt)

# --- Mailgun / Email ---
MAILGUN_API_KEY=dein_mailgun_key
MAILGUN_DOMAIN=deine_domain.com
SMTP_FROM_EMAIL=noreply@deine_domain.com

# --- Datenbank (Werte für den Docker-Container) ---
DB_USER=podcast_user
DB_PASSWORD=ein_sicheres_passwort
DB_NAME=podcast_db
DB_HOST=db
DB_PORT=3306

# --- SSH Tunnel (Optional, falls DB extern) ---
# SSH_HOST=
# SSH_USER=
# SSH_PORT=22
# SSH_KEY_PATH=/app/ssh_key
# SSH_PASSWORD=
